# Copy to .env and fill in what you have. Every variable here is optional —
# the app runs fully functional in "demo mode" (SQLite, rule-based NL
# parsing, stub auth) with none of them set.

# --- Database -----------------------------------------------------------
# Unset = SQLite at data/employee_analytics.db (zero setup).
DATABASE_URL=postgresql+psycopg2://copilot_app:copilot_dev_pw@localhost:5432/people_analytics

# --- LLM tool-selection layer --------------------------------------------
# Unset = falls back automatically to the deterministic rule-based parser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Microsoft Entra ID (Azure AD) ---------------------------------------
# All three unset = falls back automatically to the demo token->role stub
# in app/governance/permissions.py. See README "Entra ID setup" for how to
# register the app and assign roles in the Azure Portal.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
